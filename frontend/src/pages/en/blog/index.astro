---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getPublishedPosts } from '../../../lib/seo/posts';
import { getDictionary } from '../../../i18n/translations';

const posts = await getPublishedPosts('blogEn');
const t = getDictionary('en');
---

<BaseLayout
  title="SEO Blog — Ricardo Tatagiba"
  description="Practical articles on SEO, digital marketing, Google Ads, and online visibility."
  lang="en"
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-bold text-primary mb-4">{t.blogIndex.title}</h1>
    <p class="text-text-muted text-lg mb-12 max-w-2xl">
      {t.blogIndex.subtitle}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post: CollectionEntry<'blogEn'>) => (
        <article class="border border-line rounded-xl overflow-hidden hover:border-accent transition-colors flex flex-col">
          {post.data.image && (
            <a href={`/en/blog/${post.id}`}>
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-48 object-cover hover:opacity-90 transition-opacity"
                loading="lazy"
              />
            </a>
          )}
          <div class="p-6 flex flex-col flex-1">
            <time class="text-xs text-text-muted mb-2 block">
              {(post.data.date ?? post.data.pubDate ?? new Date(0)).toLocaleDateString('en-US', { day: '2-digit', month: 'long', year: 'numeric' })}
            </time>
            <h2 class="font-bold text-lg mb-2 text-primary leading-snug flex-1">
              <a href={`/en/blog/${post.id}`} class="hover:text-accent transition-colors">
                {post.data.title}
              </a>
            </h2>
            <p class="text-text-muted text-sm leading-relaxed line-clamp-3 mb-4">
              {post.data.description}
            </p>
            <a
              href={`/en/blog/${post.id}`}
              class="text-accent text-sm font-medium hover:text-accent-dark transition-colors inline-flex items-center gap-1"
            >
              {t.blogIndex.readArticle}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
