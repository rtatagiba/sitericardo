---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroServices from "../components/sections/HeroServices.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const posts = (await getCollection("blog"))
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      (b.data.date ?? b.data.pubDate ?? new Date(0)).getTime() - (a.data.date ?? a.data.pubDate ?? new Date(0)).getTime(),
  )
  .slice(0, 3);
---

<BaseLayout
  title="Ricardo Tatagiba — Sites, IA, Automações e SEO"
  description="Consultor freelancer com mais de 12 anos de experiência: criação de sites, implementação de IA, automações e SEO para o teu negócio crescer no Google."
>
  <!-- Hero -->
  <HeroServices />

  <!-- Blog recente -->
  {
    posts.length > 0 && (
      <section class="py-24 px-4">
        <div class="max-w-6xl mx-auto">
          <p class="font-mono text-sm text-accent mb-3">// Últimos artigos</p>
          <h2 class="font-display text-4xl md:text-5xl font-semibold text-primary mb-4 leading-tight">
            Artigos recentes
          </h2>
          <p class="text-text-muted mb-14 max-w-xl">
            Conteúdo prático sobre SEO, marketing digital e visibilidade online.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {posts.map((post: CollectionEntry<"blog">) => (
              <article class="border border-line rounded-lg overflow-hidden hover:border-accent transition-colors">
                {post.data.image && (
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="w-full h-48 object-cover"
                    loading="lazy"
                  />
                )}
                <div class="p-6">
                  <time class="font-mono text-xs text-text-muted mb-2 block">
                    {(post.data.date ?? post.data.pubDate ?? new Date(0)).toLocaleDateString("pt-BR", {
                      day: "2-digit",
                      month: "long",
                      year: "numeric",
                    })}
                  </time>
                  <h3 class="font-display font-semibold text-xl mb-2 text-primary leading-snug">
                    <a
                      href={`/blog/${post.id}`}
                      class="hover:text-accent transition-colors"
                    >
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="text-text-muted text-sm leading-relaxed line-clamp-3">
                    {post.data.description}
                  </p>
                </div>
              </article>
            ))}
          </div>
          <div class="mt-12">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 bg-accent text-ink font-semibold px-8 py-3.5 rounded-md hover:bg-accent-dark transition-colors"
            >
              Ver todos os artigos <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto border border-line rounded-lg px-8 py-16 md:py-20 bg-surface">
      <p class="font-mono text-sm text-accent mb-3">// Próximo passo</p>
      <h2 class="font-display text-4xl md:text-5xl font-semibold text-primary mb-5 leading-tight max-w-2xl">
        Pronto para dar o próximo passo?
      </h2>
      <p class="text-text-muted mb-10 max-w-xl text-lg">
        Vamos conversar sobre o seu negócio e como posso ajudá-lo com site,
        automação, IA ou SEO.
      </p>
      <a
        href="/contato"
        class="inline-flex items-center gap-2 bg-accent text-ink font-semibold px-10 py-4 rounded-md hover:bg-accent-dark transition-colors"
      >
        Entrar em contato <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
