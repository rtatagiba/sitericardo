---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeContent from '../../components/pages/HomeContent.astro';
import { getDictionary } from '../../i18n/translations';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const lang = 'es' as const;
const t = getDictionary(lang).home.meta;

const posts = (await getCollection('blog'))
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      (b.data.date ?? b.data.pubDate ?? new Date(0)).getTime() - (a.data.date ?? a.data.pubDate ?? new Date(0)).getTime(),
  )
  .slice(0, 3);
---

<BaseLayout title={t.title} description={t.description} lang={lang} routeKey="home">
  <HomeContent lang={lang} posts={posts} />
</BaseLayout>
