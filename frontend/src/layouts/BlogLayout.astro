---
import BaseLayout from './BaseLayout.astro';
import PostToc from '../components/PostToc.astro';
import { SITE_URL, AUTHOR } from '../lib/seo/site';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import '../styles/post.css';

interface Props {
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date;
  image?: string;
  imageCaption?: string;
  imageCredit?: string;
  category?: string;
  author?: string;
  readingMinutes?: number;
  headings?: MarkdownHeading[];
  tags?: string[];
  slug: string; // post.id in Astro v6
  relatedPosts?: CollectionEntry<'blog'>[];
}

const {
  title,
  description,
  date,
  updatedDate,
  image,
  imageCaption,
  imageCredit,
  category,
  author = AUTHOR.name,
  readingMinutes,
  headings = [],
  tags,
  slug,
  relatedPosts = [],
} = Astro.props;

const postUrl = `${SITE_URL}/blog/${slug}/`;
const dateIso = date.toISOString();

const formatDate = (value: Date) =>
  value.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });

const dateFormatted = formatDate(date);
// A data de atualização só interessa quando cai noutro dia — vários posts
// trazem um updatedDate com hora diferente da publicação, o que mostraria
// "Atualizado" com exatamente a mesma data ao lado de "Publicado".
const updatedRaw = updatedDate ? formatDate(updatedDate) : undefined;
const updatedFormatted = updatedRaw === dateFormatted ? undefined : updatedRaw;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: title },
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={title}
  canonical={postUrl}
  type="article"
  publishDate={date}
  updatedDate={updatedDate}
  tags={tags}
  breadcrumbs={breadcrumbs}
  markdownUrl={`${SITE_URL}/blog/${slug}.md`}
>
  <article>
    <div class="post-shell">
      <nav class="post-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
    </div>

    {image && (
      <figure class="post-hero">
        <img src={image} alt={title} loading="eager" fetchpriority="high" />
        {(imageCaption || imageCredit) && (
          <figcaption class="post-hero-caption">
            {imageCaption && <span>{imageCaption}</span>}
            {imageCredit && <span class="post-hero-credit">{imageCredit}</span>}
          </figcaption>
        )}
      </figure>
    )}

    <div class="post-shell">
      <div class="post-grid">
        <header class="post-header">
          <h1 class="post-title">{title}</h1>
          <p class="post-dek">{description}</p>
        </header>

        <aside class="post-aside" aria-label="Ficha do artigo">
          <div class="author-byline">
            <span class="author-byline-label">Por</span>
            <strong class="author-byline-name">{author}</strong>
          </div>

          <dl class="post-meta">
            {category && (
              <div>
                <dt>Categoria</dt>
                <dd><span class="post-meta-cat">{category}</span></dd>
              </div>
            )}
            <div class="post-meta-half">
              <dt>Publicado</dt>
              <dd><time datetime={dateIso}>{dateFormatted}</time></dd>
            </div>
            {updatedFormatted && (
              <div class="post-meta-half">
                <dt>Atualizado</dt>
                <dd class="post-meta-updated">
                  <time datetime={updatedDate!.toISOString()}>{updatedFormatted}</time>
                </dd>
              </div>
            )}
            <div class="post-meta-half">
              <dt>Leitura</dt>
              <dd>{readingMinutes ?? 1} min</dd>
            </div>
          </dl>

          <PostToc headings={headings} />
        </aside>

        <div class="post-body">
          <div class="prose">
            <slot />
          </div>
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <section class="post-footer" aria-labelledby="related-posts-heading">
          <h2 id="related-posts-heading" class="post-footer-title">Leia a seguir</h2>
          <div class="related-grid">
            {relatedPosts.slice(0, 3).map((related) => (
              <a href={`/blog/${related.id}/`} class="related-card">
                {related.data.image && (
                  <img
                    src={related.data.image}
                    alt=""
                    class="related-card-thumb"
                    loading="lazy"
                  />
                )}
                <h3 class="related-card-title">{related.data.title}</h3>
                <p class="related-card-desc">{related.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <a href="/blog" class="post-back">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Voltar ao Blog
      </a>
    </div>
  </article>
</BaseLayout>
