---
import { defaultLocale, type Locale } from '../i18n/ui';
import { routes, type RouteKey } from '../i18n/routes';
import { getDictionary } from '../i18n/translations';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: Locale;
  routeKey?: RouteKey;
}

const { lang = defaultLocale, routeKey } = Astro.props;
const t = getDictionary(lang).nav;
const { pathname } = Astro.url;
const homeHref = routes.home[lang];

const navLinks = [
  { href: homeHref, label: t.home },
  { href: routes.services[lang], label: t.services },
  { href: '/portfolio', label: t.portfolio },
  { href: '/blog', label: t.blog },
  { href: '/ferramentas', label: t.tools },
  { href: routes.about[lang], label: t.about },
  { href: routes.contact[lang], label: t.contact },
];
---

<header class="sticky top-0 z-50 bg-ink border-b border-line">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={homeHref} class="font-display font-semibold text-xl text-primary hover:text-accent transition-colors">
        Ricardo Tatagiba
      </a>

      <button id="menu-toggle" class="sm:hidden p-2 rounded-md text-text-muted hover:text-primary" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <div class="hidden sm:flex items-center gap-6">
        <ul class="flex items-center gap-6">
          {navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class={`font-mono text-xs uppercase tracking-wide transition-colors hover:text-accent ${
                  pathname === href || (href !== homeHref && pathname.startsWith(href))
                    ? 'text-accent'
                    : 'text-text-muted'
                }`}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <LanguageSwitcher lang={lang} routeKey={routeKey} />
      </div>
    </div>

    <ul id="mobile-menu" class="hidden sm:hidden flex-col gap-3 pb-4">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`block font-mono text-xs uppercase tracking-wide py-1 transition-colors hover:text-accent ${
              pathname === href ? 'text-accent' : 'text-text-muted'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2 border-t border-line mt-1">
        <LanguageSwitcher lang={lang} routeKey={routeKey} />
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>
