---
const year = new Date().getFullYear();
---

<footer class="bg-ink text-text mt-20 border-t border-line">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-display font-semibold text-lg mb-3 text-primary">Ricardo Tatagiba</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          Consultor freelancer com mais de 12 anos de experiência: sites, IA, automações e SEO.
        </p>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest mb-3 text-text-muted">Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/sobre" class="text-text-muted hover:text-accent transition-colors">Sobre</a></li>
          <li><a href="/servicos" class="text-text-muted hover:text-accent transition-colors">Serviços</a></li>
          <li><a href="/blog" class="text-text-muted hover:text-accent transition-colors">Blog</a></li>
          <li><a href="/contato" class="text-text-muted hover:text-accent transition-colors">Contato</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest mb-3 text-text-muted">Contato</h3>
        <ul class="space-y-2 text-sm text-text-muted">
          <li>
            <a href="mailto:contato@ricardotatagiba.com.br" class="hover:text-accent transition-colors">
              contato@ricardotatagiba.com.br
            </a>
          </li>
          <li>
            <a href="/politica-de-privacidade" class="hover:text-accent transition-colors">
              Política de Privacidade
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-line mt-10 pt-6 text-center text-text-muted text-xs">
      &copy; {year} Ricardo Tatagiba. Todos os direitos reservados.
    </div>
  </div>
</footer>
