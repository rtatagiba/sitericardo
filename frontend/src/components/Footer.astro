---
import { defaultLocale, type Locale } from '../i18n/ui';
import { routes } from '../i18n/routes';
import { getDictionary } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const dict = getDictionary(lang);
const { nav, footer: t } = dict;
const year = new Date().getFullYear();

const links = [
  { href: routes.about[lang], label: nav.about },
  { href: routes.services[lang], label: nav.services },
  { href: '/blog', label: nav.blog },
  { href: routes.contact[lang], label: nav.contact },
];
---

<footer class="bg-ink text-text mt-20 border-t border-line">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-display font-semibold text-lg mb-3 text-primary">Ricardo Tatagiba</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          {t.tagline}
        </p>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest mb-3 text-text-muted">{t.linksHeading}</h3>
        <ul class="space-y-2 text-sm">
          {links.map(({ href, label }) => (
            <li><a href={href} class="text-text-muted hover:text-accent transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest mb-3 text-text-muted">{t.contactHeading}</h3>
        <ul class="space-y-2 text-sm text-text-muted">
          <li>
            <a href="mailto:contato@ricardotatagiba.com.br" class="hover:text-accent transition-colors">
              contato@ricardotatagiba.com.br
            </a>
          </li>
          <li>
            <a href="/politica-de-privacidade" class="hover:text-accent transition-colors">
              {t.privacyPolicy}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-line mt-10 pt-6 text-center text-text-muted text-xs">
      {t.copyright.replace('{year}', String(year))}
    </div>
  </div>
</footer>
