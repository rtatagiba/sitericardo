---
---

<div class="w-full max-w-4xl mx-auto">
  <!-- Form -->
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row gap-2">
      <input
        id="ax-url"
        type="url"
        aria-label="URL do site a auditar"
        placeholder="https://seusite.com.br"
        class="flex-1 px-4 py-3 border border-line bg-surface rounded-lg focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent text-sm text-text placeholder-neutral-600"
      />
      <button
        id="ax-submit"
        class="px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-accent-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed text-sm whitespace-nowrap"
      >
        Auditar
      </button>
    </div>
    <label class="flex items-center gap-2 mt-3 text-xs text-text-muted cursor-pointer select-none w-fit">
      <input id="ax-diff-js" type="checkbox" class="accent-accent" />
      Comparar com JavaScript desligado (mostra o que some pro agente)
    </label>
  </div>

  <!-- Progress -->
  <div id="ax-progress" class="hidden mb-8 border border-line bg-ink rounded-xl p-5">
    <p id="ax-progress-label" class="text-sm text-text-muted mb-3">Auditando…</p>
    <ol id="ax-steps" class="space-y-1.5 text-sm"></ol>
  </div>

  <!-- Error -->
  <div id="ax-error" class="hidden mb-8 border border-red-500/30 bg-red-500/10 rounded-xl p-5">
    <p class="text-sm text-red-400" id="ax-error-message"></p>
  </div>

  <!-- Empty state -->
  <div id="ax-empty" class="text-center py-24 text-text-muted">
    <p class="text-5xl mb-4">🧭</p>
    <p class="text-lg">Cola uma URL pra ver a árvore de acessibilidade que um agente enxerga.</p>
    <p class="text-sm mt-2 max-w-md mx-auto">
      Captura via browser real, com CDP puro — não é a versão filtrada que a maioria das
      ferramentas mostra.
    </p>
  </div>

  <!-- Results -->
  <div id="ax-results" class="hidden space-y-8">
    <!-- Score -->
    <div class="border border-line bg-ink rounded-xl p-6 flex items-center gap-6">
      <div class="text-center">
        <p id="ax-score-value" class="text-5xl font-bold text-primary leading-none">—</p>
        <p id="ax-score-band" class="text-xs uppercase tracking-wide text-text-muted mt-2">—</p>
      </div>
      <div id="ax-category-bars" class="flex-1 space-y-2"></div>
    </div>

    <!-- Diff JS -->
    <div id="ax-diff-section" class="hidden border border-accent/30 bg-accent/5 rounded-xl p-6">
      <h2 class="font-semibold text-primary mb-3">Sem JavaScript, o agente perde:</h2>
      <div id="ax-diff-body" class="text-sm text-text-muted space-y-2"></div>
    </div>

    <!-- Heading outline -->
    <div class="border border-line bg-ink rounded-xl p-6">
      <h2 class="font-semibold text-primary mb-4">Outline de headings — como o agente vê</h2>
      <div id="ax-outline" class="text-sm space-y-1"></div>
    </div>

    <!-- Findings -->
    <div class="border border-line bg-ink rounded-xl p-6">
      <h2 class="font-semibold text-primary mb-4">Achados</h2>
      <div id="ax-findings" class="space-y-3"></div>
    </div>

    <!-- Tree -->
    <div class="border border-line bg-ink rounded-xl p-6">
      <h2 class="font-semibold text-primary mb-4">Árvore de acessibilidade</h2>
      <div id="ax-tree" class="text-sm font-mono max-h-[32rem] overflow-y-auto"></div>
    </div>

    <!-- Downloads -->
    <div class="flex gap-3 justify-end">
      <button id="ax-download-json" class="px-4 py-2 text-sm border border-line rounded-lg hover:bg-surface transition-colors">
        Baixar JSON
      </button>
      <button id="ax-download-md" class="px-4 py-2 text-sm border border-line rounded-lg hover:bg-surface transition-colors">
        Baixar relatório .md
      </button>
    </div>

    <!-- CTA final -->
    <div class="border border-line bg-ink rounded-xl p-6 text-center">
      <a
        id="ax-cta-audit"
        href="#"
        target="_blank"
        rel="noopener"
        class="inline-block"
        style="width: 200px;"
      >
        <span class="block w-full px-4 py-3 bg-emerald-500 text-white font-semibold rounded-lg hover:bg-emerald-600 transition-colors text-sm">
          AUDITORIA COMPLETA
        </span>
      </a>
      <p class="text-sm text-text-muted mt-3">
        Corrija seu site agora e ganhe mais visibilidade nas IAs e no Google
      </p>
    </div>
  </div>
</div>

<script>
  import { diffSnapshots, SEVERITY_POINTS } from '../../../../packages/ax-core/src/index';
  import type {
    AxFindings,
    AxSnapshot,
    AxSnapshotNode,
    DiffResult,
    Finding,
    FindingCategory,
    Severity,
  } from '../../../../packages/ax-core/src/index';

  const urlInput = document.getElementById('ax-url') as HTMLInputElement;
  const diffCheckbox = document.getElementById('ax-diff-js') as HTMLInputElement;
  const submitBtn = document.getElementById('ax-submit') as HTMLButtonElement;
  const progressSection = document.getElementById('ax-progress')!;
  const progressLabel = document.getElementById('ax-progress-label')!;
  const stepsList = document.getElementById('ax-steps')!;
  const errorSection = document.getElementById('ax-error')!;
  const errorMessage = document.getElementById('ax-error-message')!;
  const emptyState = document.getElementById('ax-empty')!;
  const resultsSection = document.getElementById('ax-results')!;
  const scoreValue = document.getElementById('ax-score-value')!;
  const scoreBand = document.getElementById('ax-score-band')!;
  const categoryBars = document.getElementById('ax-category-bars')!;
  const diffSection = document.getElementById('ax-diff-section')!;
  const diffBody = document.getElementById('ax-diff-body')!;
  const outlineEl = document.getElementById('ax-outline')!;
  const findingsEl = document.getElementById('ax-findings')!;
  const treeEl = document.getElementById('ax-tree')!;
  const downloadJsonBtn = document.getElementById('ax-download-json') as HTMLButtonElement;
  const downloadMdBtn = document.getElementById('ax-download-md') as HTMLButtonElement;
  const ctaAuditBtn = document.getElementById('ax-cta-audit') as HTMLAnchorElement;
  const WHATSAPP_NUMBER = '351961736521';

  const STEP_LABELS: Record<string, string> = {
    'abrindo-browser': 'Abrindo o browser',
    'carregando-pagina': 'Carregando a página',
    'lendo-arvore': 'Lendo a árvore de acessibilidade',
    'rodando-sondas': 'Rodando sondas complementares',
    'calculando-score': 'Calculando o score',
  };
  const STEP_ORDER = Object.keys(STEP_LABELS);

  const CATEGORY_LABELS: Record<FindingCategory, string> = {
    landmarks: 'Landmarks',
    headings: 'Headings',
    names: 'Nomes acessíveis',
    'div-soup': 'Div soup',
    links: 'Links',
    forms: 'Formulários',
    noise: 'Ruído',
  };

  const SEVERITY_LABELS: Record<Severity, string> = {
    critical: 'crítico',
    serious: 'sério',
    moderate: 'moderado',
    minor: 'menor',
  };
  const SEVERITY_ORDER: Severity[] = ['critical', 'serious', 'moderate', 'minor'];
  const SEVERITY_COLOR: Record<Severity, string> = {
    critical: 'text-red-400 border-red-500/30 bg-red-500/10',
    serious: 'text-orange-400 border-orange-500/30 bg-orange-500/10',
    moderate: 'text-amber-400 border-amber-500/30 bg-amber-500/10',
    minor: 'text-sky-400 border-sky-500/30 bg-sky-500/10',
  };

  let lastResult: { snapshot: AxSnapshot; findings: AxFindings; diff: DiffResult | null } | null = null;

  function esc(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function resetSteps() {
    stepsList.innerHTML = STEP_ORDER.map(
      (step) => `<li data-step="${step}" class="text-text-muted">○ ${STEP_LABELS[step]}</li>`,
    ).join('');
  }

  function markStep(step: string) {
    const li = stepsList.querySelector(`[data-step="${step}"]`);
    if (li) {
      li.className = 'text-text';
      li.textContent = `● ${STEP_LABELS[step] ?? step}`;
    }
  }

  function showProgress(show: boolean, label = 'Auditando…') {
    progressSection.classList.toggle('hidden', !show);
    progressLabel.textContent = label;
    if (show) resetSteps();
  }

  function showError(message: string) {
    errorSection.classList.remove('hidden');
    errorMessage.textContent = message;
    resultsSection.classList.add('hidden');
    emptyState.classList.add('hidden');
  }

  // Parseia o SSE de /api/capture. Resposta pode vir JSON direto (cache hit
  // ou erro rápido de guard) ou como stream com etapas nomeadas.
  async function captureOnce(
    url: string,
    javaScriptEnabled: boolean,
    onStep: (step: string) => void,
  ): Promise<{ snapshot: AxSnapshot; findings: AxFindings }> {
    const res = await fetch('/api/capture', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, javaScriptEnabled }),
    });

    const contentType = res.headers.get('Content-Type') ?? '';

    if (contentType.includes('application/json')) {
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? `erro HTTP ${res.status}`);
      return data;
    }

    if (!res.ok || !res.body) {
      throw new Error(`erro HTTP ${res.status}`);
    }

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const events = buffer.split('\n\n');
      buffer = events.pop() ?? '';
      for (const raw of events) {
        const line = raw.trim();
        if (!line.startsWith('data:')) continue;
        const payload = JSON.parse(line.slice(5).trim());
        if (payload.step === 'erro') throw new Error(payload.error ?? 'falha na captura');
        if (payload.step === 'concluido') return { snapshot: payload.snapshot, findings: payload.findings };
        onStep(payload.step);
      }
    }
    throw new Error('conexão encerrada antes de concluir');
  }

  function computeCategoryScores(findings: Finding[]): Array<{ category: FindingCategory; score: number }> {
    return (Object.keys(CATEGORY_LABELS) as FindingCategory[]).map((category) => {
      const deduction = findings
        .filter((f) => f.category === category)
        .reduce((sum, f) => sum + SEVERITY_POINTS[f.severity], 0);
      return { category, score: Math.max(0, 100 - deduction) };
    });
  }

  function barColor(score: number): string {
    if (score <= 40) return 'bg-red-500';
    if (score <= 70) return 'bg-amber-500';
    return 'bg-emerald-500';
  }

  function renderScore(findings: AxFindings) {
    scoreValue.textContent = String(findings.score);
    scoreBand.textContent = findings.band;
    categoryBars.innerHTML = computeCategoryScores(findings.findings)
      .map(
        ({ category, score }) => `
          <div>
            <div class="flex justify-between text-xs text-text-muted mb-1">
              <span>${CATEGORY_LABELS[category]}</span>
              <span class="tabular-nums">${score}</span>
            </div>
            <div class="h-1.5 bg-surface rounded-full overflow-hidden">
              <div class="h-full ${barColor(score)} rounded-full" style="width: ${score}%"></div>
            </div>
          </div>`,
      )
      .join('');
  }

  function renderOutline(snapshot: AxSnapshot) {
    const outline = snapshot.probes.pageMeta.headingOutline;
    if (outline.length === 0) {
      outlineEl.innerHTML = '<p class="text-text-muted">Nenhum heading encontrado.</p>';
      return;
    }
    outlineEl.innerHTML = outline
      .map(
        (h) =>
          `<div style="padding-left: ${(h.level - 1) * 1.25}rem" class="flex items-baseline gap-2">
            <span class="text-accent font-mono text-xs shrink-0">H${h.level}</span>
            <span class="text-text-muted truncate">${esc(h.text) || '(vazio)'}</span>
          </div>`,
      )
      .join('');
  }

  function renderFindings(findings: Finding[]) {
    if (findings.length === 0) {
      findingsEl.innerHTML = '<p class="text-text-muted text-sm">Nenhum achado — página passou em todos os checks.</p>';
      return;
    }
    const sorted = [...findings].sort(
      (a, b) => SEVERITY_ORDER.indexOf(a.severity) - SEVERITY_ORDER.indexOf(b.severity),
    );
    findingsEl.innerHTML = sorted
      .map((f) => {
        const evidence =
          f.evidence && f.evidence.length > 0
            ? `<details class="mt-2"><summary class="text-xs text-accent cursor-pointer">evidência</summary>
                <ul class="mt-1 text-xs text-text-muted space-y-0.5 pl-4 list-disc">
                  ${f.evidence.map((e) => `<li>${esc(e)}</li>`).join('')}
                </ul></details>`
            : '';
        return `
          <div class="border rounded-lg p-3 ${SEVERITY_COLOR[f.severity]}">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide mb-1">
              <span>${SEVERITY_LABELS[f.severity]}</span>
              <span class="opacity-60">· ${CATEGORY_LABELS[f.category]}</span>
            </div>
            <p class="text-sm text-text">${esc(f.message)}</p>
            ${evidence}
          </div>`;
      })
      .join('');
  }

  function renderDiff(diff: DiffResult | null) {
    if (!diff) {
      diffSection.classList.add('hidden');
      return;
    }
    diffSection.classList.remove('hidden');
    const parts: string[] = [];
    parts.push(`<p>Nós na árvore: <strong>${diff.nodeCountBefore}</strong> com JS → <strong>${diff.nodeCountAfter}</strong> sem JS (${diff.nodeCountDelta >= 0 ? '+' : ''}${diff.nodeCountDelta})</p>`);
    parts.push(`<p>Landmarks: <strong>${diff.landmarkCountBefore}</strong> → <strong>${diff.landmarkCountAfter}</strong></p>`);
    if (diff.interactiveRemoved.length > 0) {
      parts.push(
        `<div><p class="text-text font-medium mt-2 mb-1">Some sem JS (${diff.interactiveRemoved.length}):</p><ul class="list-disc pl-5 space-y-0.5">${diff.interactiveRemoved
          .slice(0, 20)
          .map((k) => `<li>${esc(k)}</li>`)
          .join('')}</ul></div>`,
      );
    } else {
      parts.push('<p class="text-emerald-400">Nada de interativo depende de JS pra existir na árvore. 🎉</p>');
    }
    diffBody.innerHTML = parts.join('');
  }

  function nodeLabel(node: AxSnapshotNode): string {
    const role = node.role ?? '(sem role)';
    const name = node.name ? ` "${node.name}"` : '';
    const ignored = node.ignored ? ' · ignorado' : '';
    return `${role}${name}${ignored}`;
  }

  // Constrói a árvore sob demanda: só monta os filhos quando o <details> é
  // aberto. Uma árvore real tem milhares de nós — montar tudo de uma vez
  // trava o navegador, ironia ruim numa ferramenta de acessibilidade.
  function buildTreeNode(nodeId: string, nodesById: Map<string, AxSnapshotNode>): HTMLElement {
    const node = nodesById.get(nodeId);
    if (!node) return document.createElement('span');
    const label = nodeLabel(node);
    const hasChildren = (node.childIds?.length ?? 0) > 0;

    if (!hasChildren) {
      const leaf = document.createElement('div');
      leaf.className = `py-0.5 ${node.ignored ? 'text-text-muted/50' : 'text-text-muted'}`;
      leaf.textContent = label;
      return leaf;
    }

    const details = document.createElement('details');
    const summary = document.createElement('summary');
    summary.className = `cursor-pointer py-0.5 ${node.ignored ? 'text-text-muted/50' : 'text-text'}`;
    summary.textContent = label;
    details.appendChild(summary);

    let built = false;
    details.addEventListener('toggle', () => {
      if (!details.open || built) return;
      built = true;
      const wrap = document.createElement('div');
      wrap.className = 'border-l border-line pl-3 ml-1';
      for (const childId of node.childIds ?? []) {
        wrap.appendChild(buildTreeNode(childId, nodesById));
      }
      details.appendChild(wrap);
    });

    return details;
  }

  function renderTree(snapshot: AxSnapshot) {
    treeEl.innerHTML = '';
    const nodesById = new Map(snapshot.nodes.map((n) => [n.nodeId, n]));
    const childIds = new Set(snapshot.nodes.flatMap((n) => n.childIds ?? []));
    const roots = snapshot.nodes.filter((n) => !childIds.has(n.nodeId));
    for (const root of roots) {
      treeEl.appendChild(buildTreeNode(root.nodeId, nodesById));
    }
  }

  function buildMarkdownReport(snapshot: AxSnapshot, findings: AxFindings): string {
    const lines: string[] = [
      `# Auditoria de acessibilidade — ${snapshot.url}`,
      '',
      `Score: **${findings.score}/100** (${findings.band})`,
      `Capturado em: ${snapshot.capturedAt}`,
      `JavaScript: ${snapshot.javaScriptEnabled ? 'ligado' : 'desligado'}`,
      '',
      '## Outline de headings',
    ];
    for (const h of snapshot.probes.pageMeta.headingOutline) {
      lines.push(`${'  '.repeat(Math.max(0, h.level - 1))}- H${h.level}: ${h.text}`);
    }
    lines.push('', '## Achados');
    for (const sev of SEVERITY_ORDER) {
      const items = findings.findings.filter((f) => f.severity === sev);
      if (items.length === 0) continue;
      lines.push(`### ${SEVERITY_LABELS[sev]}`);
      for (const f of items) {
        lines.push(`- **${f.id}**: ${f.message}`);
        for (const e of f.evidence ?? []) lines.push(`  - ${e}`);
      }
    }
    return lines.join('\n');
  }

  function downloadBlob(content: string, filename: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
  }

  downloadJsonBtn.addEventListener('click', () => {
    if (!lastResult) return;
    downloadBlob(
      JSON.stringify({ snapshot: lastResult.snapshot, findings: lastResult.findings }, null, 2),
      'auditoria-acessibilidade.json',
      'application/json',
    );
  });

  downloadMdBtn.addEventListener('click', () => {
    if (!lastResult) return;
    downloadBlob(buildMarkdownReport(lastResult.snapshot, lastResult.findings), 'auditoria-acessibilidade.md', 'text/markdown');
  });

  function updateCtaLink() {
    if (!lastResult) return;
    const { url, score } = { url: lastResult.snapshot.url, score: lastResult.findings.score };
    const message = `Olá Ricardo, vi que meu site (${url}) tirou ${score}/100 na auditoria de acessibilidade e quero corrigir os problemas.`;
    ctaAuditBtn.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
  }

  async function handleAudit() {
    const url = urlInput.value.trim();
    if (!url || submitBtn.disabled) return;

    errorSection.classList.add('hidden');
    resultsSection.classList.add('hidden');
    emptyState.classList.add('hidden');
    submitBtn.disabled = true;

    try {
      showProgress(true, 'Auditando com JavaScript…');
      const primary = await captureOnce(url, true, markStep);

      let diff: DiffResult | null = null;
      if (diffCheckbox.checked) {
        showProgress(true, 'Auditando sem JavaScript…');
        const secondary = await captureOnce(url, false, markStep);
        diff = diffSnapshots(primary.snapshot, secondary.snapshot, 'js');
      }

      lastResult = { snapshot: primary.snapshot, findings: primary.findings, diff };
      renderScore(primary.findings);
      renderDiff(diff);
      renderOutline(primary.snapshot);
      renderFindings(primary.findings.findings);
      renderTree(primary.snapshot);
      updateCtaLink();
      resultsSection.classList.remove('hidden');
    } catch (err) {
      showError(err instanceof Error ? err.message : 'falha desconhecida');
    } finally {
      submitBtn.disabled = false;
      showProgress(false);
    }
  }

  submitBtn.addEventListener('click', handleAudit);
  urlInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleAudit();
  });
</script>
