---
import { defaultLocale, type Locale } from '../../i18n/ui';
import { routes } from '../../i18n/routes';
import { getDictionary } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = getDictionary(lang).about;

/** Splits `**bold**` markers into renderable segments. */
function segments(text: string) {
  return text.split('**').map((part, i) => ({ bold: i % 2 === 1, text: part }));
}
---

<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <h1 class="text-4xl font-bold text-primary mb-6">{t.title}</h1>

  <div class="prose max-w-none">
    <p>{t.intro}</p>

    <h2>{t.approach.title}</h2>
    <p>{t.approach.paragraph}</p>

    <h2>{t.experience.title}</h2>
    <ul>
      {t.experience.items.map((item) => (
        <li>
          {segments(item).map((seg) => (seg.bold ? <strong>{seg.text}</strong> : seg.text))}
        </li>
      ))}
    </ul>

    <h2>{t.whyWork.title}</h2>
    {t.whyWork.paragraphs.map((p) => <p>{p}</p>)}
  </div>

  <div class="mt-12 flex flex-col sm:flex-row gap-4">
    <a
      href={routes.contact[lang]}
      class="inline-block bg-accent text-black font-semibold px-8 py-3 rounded-lg hover:bg-accent-dark transition-colors text-center"
    >
      {t.cta.talk}
    </a>
    <a
      href={routes.services[lang]}
      class="inline-block border border-primary text-primary font-semibold px-8 py-3 rounded-lg hover:bg-neutral-900 transition-colors text-center"
    >
      {t.cta.services}
    </a>
  </div>
</section>
