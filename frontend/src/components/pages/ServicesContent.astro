---
import { defaultLocale, type Locale } from '../../i18n/ui';
import { routes } from '../../i18n/routes';
import { getDictionary } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = getDictionary(lang).services;
---

<section class="bg-ink text-white py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-4 text-primary">{t.hero.title}</h1>
    <p class="text-text-muted text-lg max-w-2xl leading-relaxed">
      {t.hero.subtitle}
    </p>
  </div>
</section>

<section class="py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold mb-4">{t.specialties.title}</h2>
    <p class="text-text-muted mb-12">{t.specialties.subtitle}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {t.list.map(({ title, description }) => (
        <div class="border border-line rounded-xl p-8 hover:border-accent transition-colors hover:border-accent group">
          <h3 class="text-xl font-bold mb-3 text-primary group-hover:text-accent transition-colors">{title}</h3>
          <p class="text-text-muted leading-relaxed">{description}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 bg-accent rounded-2xl p-10 text-center text-black">
      <h2 class="text-2xl font-bold text-black mb-4">{t.cta.title}</h2>
      <p class="text-black/80 mb-8 max-w-lg mx-auto">
        {t.cta.subtitle}
      </p>
      <a
        href={routes.contact[lang]}
        class="inline-block bg-ink text-white font-semibold px-10 py-3 rounded-lg hover:bg-surface transition-colors"
      >
        {t.cta.button}
      </a>
    </div>
  </div>
</section>
