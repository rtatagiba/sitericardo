---
// Mockup de uma conversa com um assistente de IA + cartões de contexto.
---

<div class="visual" aria-hidden="true">
  <div class="chat">
    <div class="msg msg-user">
      <span>Quanto custa criar um site com SEO?</span>
    </div>
    <div class="msg msg-ai">
      <span class="msg-ai-text"
        >Depende do escopo, mas todo site que entrego já nasce otimizado
        para</span
      ><span class="caret"></span>
    </div>
  </div>

  <div class="float-card card-kb">
    <strong>342 docs</strong>
    <small>Base de conhecimento</small>
  </div>

  <div class="float-card card-speed">
    <span class="dot-live"></span>
    <div>
      <strong>1.2s</strong>
      <small>Tempo de resposta</small>
    </div>
  </div>
</div>

<style>
  .visual {
    position: relative;
    width: 100%;
    min-height: 22rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 2rem;
  }

  .chat {
    width: 100%;
    max-width: 24rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .msg {
    max-width: 88%;
    padding: 0.7rem 1rem;
    border-radius: 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .msg-user {
    align-self: flex-end;
    background: #34d874;
    color: #04120a;
    font-weight: 500;
    border-bottom-right-radius: 0.3rem;
  }

  .msg-ai {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(52, 216, 116, 0.18);
    color: rgba(230, 230, 230, 0.9);
    border-bottom-left-radius: 0.3rem;
  }

  .caret {
    display: inline-block;
    width: 0.45em;
    height: 1em;
    margin-left: 2px;
    background: #7fd9a0;
    vertical-align: text-bottom;
    animation: caret-blink 1s steps(1) infinite;
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    background: rgba(10, 20, 14, 0.92);
    border: 1px solid rgba(52, 216, 116, 0.3);
    border-radius: 0.8rem;
    padding: 0.55rem 0.85rem;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    animation: float-in 0.4s ease-out backwards;
  }
  .float-card strong {
    display: block;
    color: #f0f0f0;
    font-size: 0.9rem;
    line-height: 1.1;
  }
  .float-card small {
    color: rgba(212, 212, 212, 0.6);
    font-size: 0.66rem;
  }

  .card-kb {
    top: 1.2rem;
    left: 0.5rem;
    animation-delay: 60ms;
  }
  .card-speed {
    bottom: 1.8rem;
    right: 0.5rem;
    animation-delay: 140ms;
  }

  .dot-live {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #34d874;
    box-shadow: 0 0 0 3px rgba(52, 216, 116, 0.2);
    flex-shrink: 0;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-card,
    .caret {
      animation: none;
    }
  }
</style>
