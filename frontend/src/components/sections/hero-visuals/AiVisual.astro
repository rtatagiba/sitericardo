---
// Mockup de uma conversa com um assistente de IA + cartões de contexto.
---

<div class="visual" aria-hidden="true">
  <div class="chat">
    <div class="msg msg-user">
      <span>Quanto custa criar um site com SEO?</span>
    </div>
    <div class="msg msg-ai">
      <span class="msg-ai-text"
        >Depende do escopo, mas todo site que entrego já nasce otimizado
        para</span
      ><span class="caret"></span>
    </div>
  </div>

  <div class="float-card card-kb">
    <strong>342 docs</strong>
    <small>Base de conhecimento</small>
  </div>

  <div class="float-card card-speed">
    <span class="dot-live"></span>
    <div>
      <strong>1.2s</strong>
      <small>Tempo de resposta</small>
    </div>
  </div>
</div>

<style>
  .visual {
    position: relative;
    width: 100%;
    min-height: 22rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 2rem;
  }

  .chat {
    width: 100%;
    max-width: 24rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .msg {
    max-width: 88%;
    padding: 0.7rem 1rem;
    border-radius: 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .msg-user {
    align-self: flex-end;
    background: var(--color-accent);
    color: var(--color-ink);
    font-weight: 600;
    border-radius: 0.3rem;
  }

  .msg-ai {
    align-self: flex-start;
    background: transparent;
    border: 1px solid var(--color-line);
    color: var(--color-text-muted);
    border-radius: 0.3rem;
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
  }

  .caret {
    display: inline-block;
    width: 0.45em;
    height: 1em;
    margin-left: 2px;
    background: var(--color-accent);
    vertical-align: text-bottom;
    animation: caret-blink 1s steps(1) infinite;
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 0.7rem 1rem;
    animation: float-in 0.4s ease-out backwards;
  }
  .float-card strong {
    display: block;
    font-family: var(--font-family-display);
    font-weight: 600;
    color: var(--color-text);
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .float-card small {
    font-family: var(--font-family-mono);
    color: var(--color-text-muted);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .card-kb {
    top: 1.2rem;
    left: 0.5rem;
    animation-delay: 60ms;
  }
  .card-speed {
    bottom: 1.8rem;
    right: 0.5rem;
    animation-delay: 140ms;
  }

  .dot-live {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-sage);
    flex-shrink: 0;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-card,
    .caret {
      animation: none;
    }
  }
</style>
