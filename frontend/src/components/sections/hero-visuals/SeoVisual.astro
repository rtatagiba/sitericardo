---
// Mockup de uma página de resultados de busca com o site em #1 + gráfico de tráfego.
---

<div class="visual" aria-hidden="true">
  <div class="serp">
    <div class="serp-search">
      <span class="serp-search-icon">⌕</span>
      <span class="serp-search-text">consultor seo lisboa</span>
    </div>

    <div class="result result-1">
      <span class="badge-1">1</span>
      <div>
        <span class="result-url">ricardotatagiba.com.br</span>
        <span class="result-title">Ricardo Tatagiba — Consultor SEO</span>
      </div>
    </div>

    <div class="result result-muted">
      <div>
        <span class="result-url dim">concorrente-a.com.br</span>
        <span class="result-title dim"></span>
      </div>
    </div>

    <div class="result result-muted">
      <div>
        <span class="result-url dim">concorrente-b.com.br</span>
        <span class="result-title dim"></span>
      </div>
    </div>
  </div>

  <div class="float-card card-rank">
    <strong>Posição #1</strong>
    <small>"consultor seo lisboa"</small>
  </div>

  <div class="float-card card-chart">
    <svg class="mini-chart" viewBox="0 0 80 32" fill="none">
      <path
        d="M2 28 L16 24 L30 25 L44 14 L58 16 L78 4"
        stroke="#c98a2c"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <div>
      <strong>+184%</strong>
      <small>Tráfego orgânico</small>
    </div>
  </div>
</div>

<style>
  .visual {
    position: relative;
    width: 100%;
    min-height: 22rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 2rem;
  }

  .serp {
    width: 100%;
    max-width: 24rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 1.1rem 1.1rem 1.3rem;
  }

  .serp-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.4rem;
    padding: 0.5rem 0.9rem;
    margin-bottom: 1rem;
    font-family: var(--font-family-mono);
  }
  .serp-search-icon {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .serp-search-text {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .result {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .result:last-child {
    border-bottom: none;
  }

  .badge-1 {
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 0.3rem;
    background: var(--color-accent);
    color: var(--color-ink);
    font-family: var(--font-family-mono);
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.1rem;
  }

  .result-1 {
    border-radius: 0.4rem;
    padding: 0.65rem 0.6rem;
    border-bottom: none;
  }

  .result-url {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.66rem;
    color: var(--color-accent);
    margin-bottom: 0.15rem;
  }
  .result-title {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .result-muted {
    padding-left: 2rem;
  }
  .dim {
    opacity: 0.35;
  }
  .result-title.dim {
    height: 0.6rem;
    width: 70%;
    background: var(--color-line);
    border-radius: 999px;
  }

  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 0.7rem 1rem;
    animation: float-in 0.4s ease-out backwards;
  }
  .float-card strong {
    display: block;
    font-family: var(--font-family-display);
    font-weight: 600;
    color: var(--color-text);
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .float-card small {
    font-family: var(--font-family-mono);
    color: var(--color-text-muted);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .card-rank {
    top: 1.2rem;
    right: 0.5rem;
    animation-delay: 60ms;
  }
  .card-chart {
    bottom: 1.5rem;
    left: 0.5rem;
    animation-delay: 140ms;
  }

  .mini-chart {
    width: 2.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-card {
      animation: none;
    }
  }
</style>
