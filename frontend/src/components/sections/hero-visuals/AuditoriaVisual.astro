---
// Mockup de um relatório de auditoria: anel de score + checklist de achados.
---

<div class="visual" aria-hidden="true">
  <div class="report">
    <div class="report-head">
      <div class="score-ring">
        <span class="score-value">94</span>
      </div>
      <div>
        <span class="score-label">Score geral</span>
        <span class="score-before">era 68</span>
      </div>
    </div>

    <ul class="checklist">
      <li class="ok"><span class="mark">✓</span> Core Web Vitals</li>
      <li class="ok"><span class="mark">✓</span> Indexação</li>
      <li class="warn"><span class="mark">!</span> Dados estruturados (schema)</li>
      <li class="warn"><span class="mark">!</span> 12 links quebrados</li>
    </ul>
  </div>

  <div class="float-card card-issues">
    <strong>27</strong>
    <small>Pontos corrigidos</small>
  </div>
</div>

<style>
  .visual {
    position: relative;
    width: 100%;
    min-height: 22rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 2rem;
  }

  .report {
    width: 100%;
    max-width: 22rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 1.3rem 1.3rem 1.4rem;
  }

  .report-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.1rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .score-ring {
    flex-shrink: 0;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 999px;
    background: conic-gradient(var(--color-accent) 0 94%, var(--color-line) 0);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .score-ring::before {
    content: "";
    position: absolute;
  }
  .score-value {
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 999px;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .score-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .score-before {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .checklist li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .mark {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 0.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-mono);
    font-size: 0.65rem;
    font-weight: 700;
    border: 1px solid var(--color-line);
  }
  .ok .mark {
    color: var(--color-sage);
  }
  .warn .mark {
    color: var(--color-accent);
  }

  .float-card {
    position: absolute;
    top: 1.4rem;
    right: 0.8rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 0.7rem 1rem;
    animation: float-in 0.4s ease-out 100ms backwards;
  }
  .float-card strong {
    display: block;
    font-family: var(--font-family-display);
    font-weight: 600;
    color: var(--color-text);
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .float-card small {
    font-family: var(--font-family-mono);
    color: var(--color-text-muted);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-card {
      animation: none;
    }
  }
</style>
